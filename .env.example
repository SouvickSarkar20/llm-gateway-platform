# Application Configuration
APP_NAME=AI-Platform-QA-API
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
API_V1_PREFIX=/api/v1

# Security & JWT Authentication
# In production, generate a secure random 256-bit key using: openssl rand -hex 32
JWT_SECRET_KEY=change-this-super-secret-key-in-production-must-be-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration (PostgreSQL in Docker, SQLite fallback for local test)
# Format: postgresql+asyncpg://<username>:<password>@localhost:5432/chat_platform
DATABASE_URL=sqlite+aiosqlite:///./chat_platform.db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Redis Configuration (Caching & Distributed Rate Limiting)
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=3600
REDIS_CONNECT_TIMEOUT_SECONDS=2

# Rate Limiter Limits (Token Bucket / Sliding Window)
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# LLM Gateway Configuration
# LLM_PROVIDER: "mock", "openai", "gemini"
LLM_PROVIDER=mock
PRIMARY_MODEL=gpt-4o-mini
FALLBACK_MODEL=gpt-3.5-turbo
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_REQUEST_TIMEOUT_SECONDS=10.0

# Circuit Breaker & Retry Policies
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30.0
MAX_RETRIES=3
BASE_BACKOFF_SECONDS=0.5
MAX_BACKOFF_SECONDS=4.0
JITTER_FACTOR=0.25

# Observability
PROMETHEUS_METRICS_PATH=/metrics
ENABLE_STRUCTURED_LOGGING=true
